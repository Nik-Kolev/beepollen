enum StockLevel {
  PLENTY
  LOW
  NONE
}

model Product {
  id          Int        @id @default(autoincrement())
  slug        String     @unique
  name        String
  summary     String
  description String
  variety     String?
  priceCents  Int
  stock       StockLevel @default(PLENTY)
  sortOrder   Int        @default(0)
  isPublished Boolean    @default(false)

  netWeightGrams Int?
  composition    String?
  origin         String?
  storage        String?
  bestBefore     String?
  allergenInfo   String?

  energyKj       Int?
  energyKcal     Int?
  fatMg          Int?
  saturatesMg    Int?
  carbohydrateMg Int?
  sugarsMg       Int?
  proteinMg      Int?
  saltMg         Int?

  images           ProductImage[]
  orderItems       OrderItem[]
  promotions       Promotion[]
  priceChanges     PriceChange[]
  campaignProducts CampaignProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

enum PromotionKind {
  PERCENT
  PRICE
}

model Promotion {
  id        Int           @id @default(autoincrement())
  productId Int
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind      PromotionKind
  value     Int
  startsOn  String
  endsOn    String
  endedAt   DateTime?
  createdBy String
  createdAt DateTime      @default(now())

  campaigns Campaign[]

  @@index([productId, startsOn])
}

model PriceChange {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromCents Int
  toCents   Int
  changedBy String
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

model ProductImage {
  id          Int     @id @default(autoincrement())
  productId   Int
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  path        String
  alt         String
  blurDataURL String?
  sortOrder   Int     @default(0)

  @@index([productId])
}
