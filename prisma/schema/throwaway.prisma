model Sprocket {
  id        Int      @id @default(autoincrement())
  label     String   @unique
  createdAt DateTime @default(now())
  cogs      Cog[]
}

model Cog {
  id         Int      @id @default(autoincrement())
  nickname   String
  sprocketId Int
  sprocket   Sprocket @relation(fields: [sprocketId], references: [id], onDelete: Cascade)

  @@index([sprocketId])
}
