enum OrderStatus {
  NEW
  SHIPPED
  CANCELLED
}

enum ConsentKind {
  TERMS
  OFFERS
}

model Customer {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique
  phone String

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id         Int         @id @default(autoincrement())
  customerId Int
  customer   Customer    @relation(fields: [customerId], references: [id])
  status     OrderStatus @default(NEW)

  contactName  String
  contactPhone String

  officeCarrier Carrier
  officeCode    String
  officeName    String
  officeCity    String
  officeStreet  String

  itemsCents    Int
  deliveryCents Int @default(0)
  totalCents    Int

  reference String @unique

  idempotencyKey String @unique

  items    OrderItem[]
  consents Consent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([createdAt])
}

model OrderItem {
  id      Int   @id @default(autoincrement())
  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  slug           String
  name           String
  unitPriceCents Int
  quantity       Int

  @@index([orderId])
  @@index([productId])
}

model Consent {
  id      Int         @id @default(autoincrement())
  orderId Int
  order   Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind    ConsentKind

  wording   String
  ipAddress String?
  createdAt DateTime @default(now())

  @@unique([orderId, kind])
  @@index([orderId])
}
